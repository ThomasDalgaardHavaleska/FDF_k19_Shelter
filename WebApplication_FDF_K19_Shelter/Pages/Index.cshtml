@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="text-center">
    <h1 class="display-4">FDF K19 Shelterudlejning</h1>
</div>

<div style="display:flex; gap:20px; align-items:flex-start;">
    <div style="background-color:#f4f8fb; border:1px solid #cfe0f5; border-radius:12px; padding:20px; max-width:400px; font-family:Arial, sans-serif; box-shadow:0 4px 8px rgba(0,0,0,0.05);">
      
        <h2 style="margin-top:0; color:#2c5aa0;">🏕️ Shelterbooking – FDF K19</h2>
      
        <p style="margin:10px 0; color:#333;">
            Book nemt shelter online og få overblik over ledige datoer – uden telefonkø og ventetid.
        </p>
        <p>Du skal bare udfylde følgende:</p>
      
        <ul style="padding-left:20px; color:#333;">
            <li>Kredsnavn</li>
            <li>Antal deltagere</li>
            <li>Aldersgruppe</li>
            <li>Ønsket periode for udlejning</li>
        </ul>
      
        <p style="margin-top:15px; font-weight:bold; color:#2c5aa0;">
            Effektiv booking og bedre overblik – samlet ét sted.
        </p>
      
        <a href="/shelters" style="display:inline-block; margin-top:10px; padding:10px 15px; background-color:#2c5aa0; color:white; text-decoration:none; border-radius:8px;">
            Book nu
        </a>
    </div>

    <div class="container mt-3">
        <img src="~/pictures/screenshot 2026-05-22 095858.png" class="float-end" width="464" height="248"/>
    </div>
</div>



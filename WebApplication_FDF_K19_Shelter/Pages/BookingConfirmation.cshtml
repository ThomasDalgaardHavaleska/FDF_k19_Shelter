@page
@model WebApplication_FDF_K19_Shelter.Pages.BookingConfirmationModel
@{
    ViewData["Title"] = "Om";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script type="importmap"></script>
    <title>@ViewData["Title"] Om </title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/BookingConfirmation.css" asp-append-version="true" />
</head>

<div style="display: flex; gap: 30px; align-items: flex-start;">
    <div style="flex: 1;">
        <h1>Tak For Din Booking!</h1>
        <p>Din tid er blevet registreret hos FDF.<br />Vi håber du nyder dit ophold.</p>
   
        @if(Model.Booking != null)
           { 
			<li>Id: @Model.Booking.BookingId</li> 
            <li>Navn: @Model.Booking.FullName</li>
            <li> Shelter: @Model.Booking.ShelterToBook.Name</li> 
            <li>Check ind / Check ud: @Model.Booking.CheckInDate.ToShortDateString() to @Model.Booking.CheckoutDate.ToShortDateString()</li>
            <li>Aldersgruppe: @Model.Booking.AgeGroup</li>
            <li>Kreds: @Model.Booking.DistrictOfUser.Name</li>
           }

        <div>
            <a href="/Bookings">
                <button>Se Bookinger her</button>
            </a>
        </div>
    </div>

    <div>
        <img src="~/pictures/james-itliong-o39o0yxruw4-unsplash.jpg" width="800" height="600" style="border-radius: 8px;" />
    </div>
</div>
